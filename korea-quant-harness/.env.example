# 실제 값은 절대 커밋하지 마십시오. 운영 환경의 비밀관리 수단(환경변수/시크릿 매니저)을 사용합니다.
KQH_MODE=PAPER                 # PAPER | LIVE  (LIVE는 artifacts/approvals 승인 기록 + 아래 확인값 필요)
KQH_LIVE_CONFIRM=              # LIVE 진입 시 운영자가 입력하는 확인 문자열 (현재 LIVE 경로는 미구현)
KQH_KILL_FILE=./run/KILL       # 이 파일이 존재하면 모든 신규 주문 차단 (프로세스 외부 킬스위치)

# --- 아래는 GATE 3 이후 연동 단계에서만 사용 (현재 코드에서 읽지 않음) ---
# KIS_PAPER_APP_KEY=
# KIS_PAPER_APP_SECRET=
# KIS_LIVE_APP_KEY=            # 실계좌 키는 주문 프로세스 전용 환경에만 주입
# KIS_LIVE_APP_SECRET=
# DART_API_KEY=
# ECOS_API_KEY=
# ANTHROPIC_API_KEY=
